+    def _maybe_persist_rating_history(self, ratings: List[Dict]) -> None:
+        """Persist a snapshot no more often than RATING_HISTORY_INTERVAL_SEC."""
+        if not ratings:
+            return
+        now = time.time()
+        with _cache_lock:
+            last_ts = float(_rating_history_state.get("ts", 0.0) or 0.0)
+            if (now - last_ts) < RATING_HISTORY_INTERVAL_SEC:
+                return
+            _rating_history_state["ts"] = now
+
+        try:
+            ts = datetime.utcnow().replace(microsecond=0).isoformat() + "Z"
+            rows = []
+            for r in ratings:
+                rows.append(
+                    (
+                        ts,
+                        (r.get("ticker") or "").upper(),
+                        r.get("rating"),
+                        r.get("score"),
+                        r.get("confidence"),
+                        r.get("current_price"),
+                        r.get("currency"),
+                        r.get("rsi"),
+                        r.get("sentiment_score"),
+                        r.get("technical_score"),
+                    )
+                )
+
+            conn = sqlite3.connect(self.db_path)
+            cursor = conn.cursor()
+            cursor.executemany(
+                """
+                INSERT INTO rating_history (
+                    ts, ticker, rating, score, confidence, current_price, currency, rsi, sentiment_score, technical_score
+                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+                """,
+                rows,
+            )
+            conn.commit()
+            conn.close()
+        except Exception as e:
+            logger.error(f"persist rating history failed: {e}")
+
+    def get_rating_history(self, ticker: str, limit: int = 200) -> List[Dict]:
+        """Return recent rating snapshots for one ticker (ascending by time)."""
+        t = (ticker or "").upper().strip()
+        if not t:
+            return []
+        limit = max(1, min(int(limit or 200), 2000))
+        try:
+            conn = sqlite3.connect(self.db_path)
+            conn.row_factory = sqlite3.Row
+            cursor = conn.cursor()
+            cursor.execute(
+                """
+                SELECT ts, ticker, rating, score, confidence, current_price, currency, rsi, sentiment_score, technical_score
+                FROM rating_history
+                WHERE ticker = ?
+                ORDER BY ts DESC
+                LIMIT ?
+                """,
+                (t, limit),
+            )
+            rows = [dict(r) for r in cursor.fetchall()]
+            conn.close()
+            rows.reverse()
+            return rows
+        except sqlite3.OperationalError:
+            return []
+        except Exception as e:
+            logger.error(f"get_rating_history failed: {e}")
+            return []
 
