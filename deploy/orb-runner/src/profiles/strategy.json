{
  "mode": "daily_universe",
  "universe": {
    "price_min": 10,
    "price_max": 80,
    "min_dollar_volume": 50000000,
    "max_symbols": 10
  },
  "symbols": {
    "include": ["AMD"],
    "exclude": []
  },
  "session": {
    "type": "RTH",
    "include_premarket": false,
    "include_afterhours": false
  },
  "orb": {
    "range_minutes": 1,
    "entry_delay_minutes": 15
  },
  "entry": {
    "type": "ORB_RAW",
    "atr_buffer_pct": 0.0,
    "confirmation_bars": 1
  },
  "exit": {
    "type": "FIXED_STOP",
    "stop_pct": 2.0,
    "time_stop_minutes": null,
    "force_flat_minutes_before_close": 5
  },
  "risk": {
    "max_trades_per_day": 1,
    "position_pct": 0.1,
    "max_daily_loss_pct": 2.0
  }
}
