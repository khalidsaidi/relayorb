rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isServiceAccount() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@relayorb.iam.gserviceaccount.com');
    }

    function brokerAccountDoc(brokerAccountKey) {
      return get(/databases/$(database)/documents/brokerAccounts/$(brokerAccountKey));
    }

    function isAllowedBrokerAccount(brokerAccountKey) {
      return isAuthenticated()
        && brokerAccountDoc(brokerAccountKey).data.allowedUids != null
        && request.auth.uid in brokerAccountDoc(brokerAccountKey).data.allowedUids;
    }

    // Any authenticated user (for general read access)
    function isAuthenticated() {
      return request.auth != null;
    }

    // IBKR-specific paths require broker user access
    match /tradeProposals/{proposalId} {
      allow read: if isAllowedBrokerAccount(resource.data.brokerAccountKey);
      allow write: if isServiceAccount();
    }

    match /executionRequests/{requestId} {
      allow read: if isAllowedBrokerAccount(resource.data.brokerAccountKey);
      allow create: if isAllowedBrokerAccount(request.resource.data.brokerAccountKey)
        && request.resource.data.status in ["draft", "approved"]
        && request.resource.data.approvedByUid == request.auth.uid;
      // Service accounts can update with valid status transitions:
      // draft → approved, rejected
      // approved → executed, rejected, expired
      // executed, rejected, expired are terminal states (no updates allowed to status)
      allow update: if isServiceAccount()
        && (
          // No status change (other fields being updated)
          request.resource.data.status == resource.data.status
          // draft → approved or rejected
          || (resource.data.status == "draft" && request.resource.data.status in ["approved", "rejected"])
          // approved → executed, rejected, or expired
          || (resource.data.status == "approved" && request.resource.data.status in ["executed", "rejected", "expired"])
        );
      allow delete: if isServiceAccount();
    }

    match /brokerOrders/{requestId} {
      allow read: if isAllowedBrokerAccount(resource.data.brokerAccountKey);
      allow write: if isServiceAccount();
    }

    match /brokerPositions/{positionId} {
      allow read: if isAllowedBrokerAccount(resource.data.brokerAccountKey);
      allow write: if isServiceAccount();
    }

    match /brokerAccountSummaries/{brokerAccountKey} {
      allow read: if isAllowedBrokerAccount(brokerAccountKey);
      allow write: if isServiceAccount();
    }

    match /brokerAccounts/{brokerAccountKey} {
      allow read: if isAllowedBrokerAccount(brokerAccountKey);
      allow create, delete: if isServiceAccount();
      allow update: if isServiceAccount()
        || (isAllowedBrokerAccount(brokerAccountKey)
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["enabled", "paperEnabled", "ordersRefreshRequestedAt", "updatedAt"])
          && request.resource.data.liveEnabled == resource.data.liveEnabled);
    }

    match /brokerInstruments/{assetKey} {
      allow read: if isAuthenticated();
      allow write: if isServiceAccount();
    }

    match /trading/controls {
      allow read: if isAuthenticated() || isServiceAccount();
      allow write: if isServiceAccount();
    }

    match /orbControls/{brokerAccountKey} {
      allow read: if isServiceAccount()
        || isAllowedBrokerAccount(brokerAccountKey);
      allow write: if isServiceAccount()
        || isAllowedBrokerAccount(brokerAccountKey);
    }

    match /orbStates/{brokerAccountKey} {
      allow read: if isServiceAccount()
        || isAllowedBrokerAccount(brokerAccountKey);
      allow write: if isServiceAccount();
    }

    // Paper trading: authenticated users can manage their own data
    match /paper_wallets/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Presence: authenticated users can write their own presence
    match /presence/{presenceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Stream symbols: authenticated users can update watched symbols
    match /market/streamSymbols {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Replay stream symbols
    match /replay/controls/runs/{runId}/market/streamSymbols {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /replay/controls {
      allow read: if isAuthenticated() || isServiceAccount();
      allow write: if isAuthenticated() || isServiceAccount();
    }

    // Market settings: allow authenticated dashboard edits
    match /market/controls {
      allow read: if isAuthenticated() || isServiceAccount();
      allow write: if isAuthenticated();
    }

    match /market/universe {
      allow read: if isAuthenticated() || isServiceAccount();
      allow write: if isAuthenticated();
    }

    match /batches/{batchId} {
      allow create: if isAuthenticated()
        && request.resource.data.type == "refresh"
        && request.resource.data.requestedByUid == request.auth.uid;
      allow read, update, delete: if isServiceAccount();
    }

    // General collections: any authenticated user can read, only service accounts can write
    match /{document=**} {
      allow read: if isAuthenticated() || isServiceAccount();
      allow write: if isServiceAccount();
    }
  }
}
