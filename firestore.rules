rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          "khalidsaidi66@gmail.com",
          "relayorb-admin-test@relayorb.local"
        ];
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
